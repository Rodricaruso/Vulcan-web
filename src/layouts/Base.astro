---
import '../styles/global.css';
import { sitio, preguntas } from '../content';
import { idNegocio, idWeb } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  conDatosEstructurados?: boolean; // la home: suma el schema WebSite
  conPreguntas?: boolean; // schema FAQPage: solo en la página que muestra las preguntas
  migas?: { nombre: string; ruta: string }[]; // schema BreadcrumbList, desde el inicio hasta esta página
  sinIndexar?: boolean; // páginas que todavía no deben salir en buscadores
  esquema?: Record<string, unknown>[]; // nodos propios de la página (caso, pieza…), se suman al @graph
}

const { title = sitio.title, description = sitio.description, conDatosEstructurados = false, conPreguntas = false, migas, sinIndexar = false, esquema = [] } = Astro.props;
// Sin barra final, igual que los enlaces internos y que Vercel (vercel.json).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const imagenCompartir = new URL('/compartir.jpg', Astro.site);

const redes = [sitio.instagram, ...sitio.redes].filter(Boolean);

const negocio = {
  '@type': 'JewelryStore',
  '@id': idNegocio(Astro.site),
  name: sitio.nombre,
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
  telephone: sitio.telefonoVisible,
  image: imagenCompartir.href,
  description: sitio.description,
  priceRange: '$$',
  currenciesAccepted: 'ARS',
  ...(sitio.formasDePago ? { paymentAccepted: sitio.formasDePago } : {}),
  knowsAbout: ['Anillos sello', 'Joyería a medida', 'Impresión 3D de joyería', 'Fundición a la cera perdida', 'Modelado 3D'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ciudad Autónoma de Buenos Aires',
    addressRegion: 'CABA',
    addressCountry: 'AR',
  },
  areaServed: 'AR',
  ...(redes.length ? { sameAs: redes } : {}),
  ...(sitio.horario.length
    ? {
        openingHoursSpecification: sitio.horario.map((h) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: h.dias,
          opens: h.abre,
          closes: h.cierra,
        })),
      }
    : {}),
};

const web = {
  '@type': 'WebSite',
  '@id': idWeb(Astro.site),
  name: sitio.nombre,
  url: Astro.site?.href,
  inLanguage: 'es-AR',
  publisher: { '@id': idNegocio(Astro.site) },
};

// Solo preguntas con respuesta real: las que tienen [pendientes] no se publican en el schema.
const faq = {
  '@type': 'FAQPage',
  mainEntity: preguntas.items
    .filter((p) => !p.respuesta.join(' ').includes('['))
    .map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: [...p.respuesta, ...(p.formula ?? [])].join(' '),
      },
    })),
};

const breadcrumb = migas && {
  '@type': 'BreadcrumbList',
  itemListElement: migas.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.nombre,
    item: new URL(m.ruta, Astro.site).href,
  })),
};

// Un solo JSON-LD por página. El negocio va siempre: es a quien apuntan los demás nodos.
const grafo = {
  '@context': 'https://schema.org',
  '@graph': [negocio, ...(conDatosEstructurados ? [web] : []), ...(conPreguntas ? [faq] : []), ...(breadcrumb ? [breadcrumb] : []), ...esquema],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {sinIndexar ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1d0605" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Anillo sello de plata con un rosetón grabado, mitad terminado y mitad modelo 3D" />
    <meta name="twitter:card" content="summary_large_image" />
    {!sinIndexar && <script is:inline type="application/ld+json" set:html={JSON.stringify(grafo)} />}
    {sitio.googleAnalytics && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${sitio.googleAnalytics}`}></script>
        <script is:inline define:vars={{ id: sitio.googleAnalytics }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            dataLayer.push(arguments);
          };
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </Fragment>
    )}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Evento de analytics por cada CTA, con el mismo código que va en el mensaje.
  document.addEventListener('click', (e) => {
    const cta = (e.target as Element).closest<HTMLElement>('[data-ref]');
    if (!cta) return;
    const w = window as unknown as { gtag?: (...args: unknown[]) => void; dataLayer?: unknown[] };
    w.gtag?.('event', 'contacto_whatsapp', { ref: cta.dataset.ref });
    w.dataLayer?.push({ event: 'contacto_whatsapp', ref: cta.dataset.ref });
  });
</script>
