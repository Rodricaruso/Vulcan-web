---
import '../styles/global.css';
import { sitio, preguntas } from '../content';

interface Props {
  title?: string;
  description?: string;
  conDatosEstructurados?: boolean;
  conPreguntas?: boolean; // schema FAQPage: solo en la página que muestra las preguntas
  migas?: { nombre: string; ruta: string }[]; // schema BreadcrumbList, desde el inicio hasta esta página
  sinIndexar?: boolean; // páginas que todavía no deben salir en buscadores
}

const { title = sitio.title, description = sitio.description, conDatosEstructurados = false, conPreguntas = false, migas, sinIndexar = false } = Astro.props;
// Sin barra final, igual que los enlaces internos y que Vercel (vercel.json).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const imagenCompartir = new URL('/compartir.jpg', Astro.site);

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'JewelryStore',
  name: sitio.nombre,
  url: Astro.site?.href,
  telephone: sitio.telefonoVisible,
  image: imagenCompartir.href,
  description: sitio.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ciudad Autónoma de Buenos Aires',
    addressRegion: 'CABA',
    addressCountry: 'AR',
  },
  areaServed: 'AR',
  ...(sitio.instagram ? { sameAs: [sitio.instagram] } : {}),
};

// Solo preguntas con respuesta real: las que tienen [pendientes] no se publican en el schema.
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.items
    .filter((p) => !p.respuesta.join(' ').includes('['))
    .map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: {
        '@type': 'Answer',
        text: [...p.respuesta, ...(p.formula ?? [])].join(' '),
      },
    })),
};

const breadcrumb = migas && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: migas.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.nombre,
    item: new URL(m.ruta, Astro.site).href,
  })),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {sinIndexar ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1d0605" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Anillo sello de plata con un rosetón grabado, mitad terminado y mitad modelo 3D" />
    <meta name="twitter:card" content="summary_large_image" />
    {conDatosEstructurados && <script is:inline type="application/ld+json" set:html={JSON.stringify(negocio)} />}
    {conPreguntas && <script is:inline type="application/ld+json" set:html={JSON.stringify(faq)} />}
    {breadcrumb && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Evento de analytics por cada CTA, con el mismo código que va en el mensaje.
  document.addEventListener('click', (e) => {
    const cta = (e.target as Element).closest<HTMLElement>('[data-ref]');
    if (!cta) return;
    const w = window as unknown as { gtag?: (...args: unknown[]) => void; dataLayer?: unknown[] };
    w.gtag?.('event', 'contacto_whatsapp', { ref: cta.dataset.ref });
    w.dataLayer?.push({ event: 'contacto_whatsapp', ref: cta.dataset.ref });
  });
</script>
