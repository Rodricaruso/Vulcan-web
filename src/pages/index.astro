---
// Home: la bitácora de una pieza. Siete actos, ver scrollcraft/builds/vulcan/BRIEF.md.
// El motor de scroll (public/scrollcraft/) no se edita: se tematiza con los tokens de abajo.
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Transformacion from '../components/home/Transformacion.astro';
import Frases from '../components/home/Frases.astro';
import Factum from '../components/home/Factum.astro';
import Recorrido from '../components/home/Recorrido.astro';
import Vitrina from '../components/home/Vitrina.astro';
import Obra from '../components/home/Obra.astro';
import Orden from '../components/home/Orden.astro';
import Footer from '../components/Footer.astro';
---

<Base conDatosEstructurados>
  <link slot="head" rel="stylesheet" href="/scrollcraft/scrollcraft.css" />

  <Navbar />
  <main id="contenido" tabindex="-1">
    <Transformacion />
    <Frases />
    <Factum />
    <Obra />
    <Recorrido />
    <Vitrina />
    <Orden />
  </main>
  <Footer />

  <script is:inline src="/scrollcraft/scrollcraft.js"></script>
  <script is:inline>ScrollCraft.mount(document.body);</script>
</Base>

<style is:global>
  /* Los seis colores y las dos letras del motor, con la paleta de Vulcan. */
  :root {
    --sc-canvas: var(--color-bg);
    --sc-surface: var(--color-surface);
    --sc-ink: var(--color-text);
    --sc-ink-soft: var(--color-text-muted);
    --sc-accent: var(--color-accent);
    --sc-accent-ink: var(--color-bg);
    --sc-font-display: var(--font-display);
    --sc-font-text: var(--font-body);
    --sc-font-mono: var(--font-mono);
  }

  /* El motor pinta el body liso; acá vuelve la textura de piedra y la letra del sitio. */
  html body {
    background: var(--color-bg) url('/texturas/forja.webp') 0 0 / 100% auto repeat-y;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: normal;
  }
</style>
