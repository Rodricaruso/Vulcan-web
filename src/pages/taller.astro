---
// El taller: lo que la home resume. Proceso técnico, servicios para el gremio,
// metales del día y preguntas frecuentes.
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Proceso from '../components/Proceso.astro';
import Servicios from '../components/Servicios.astro';
import Metales from '../components/Metales.astro';
import Preguntas from '../components/Preguntas.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import { taller } from '../content';
---

<Base title={taller.meta.title} description={taller.meta.description} conPreguntas>
  <Navbar />
  <main id="contenido" tabindex="-1">
    <header class="contenedor taller__cabecera">
      <h1>{taller.titulo}</h1>
      <p class="bajada">{taller.bajada}</p>
    </header>
    <Proceso />
    <Servicios />
    <Metales />
    <Preguntas />
    <CtaFinal />
  </main>
  <Footer />
</Base>

<style>
  .taller__cabecera {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--seccion);
  }

  .taller__cabecera h1 {
    max-width: 16ch;
  }
</style>
