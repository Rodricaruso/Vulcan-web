---
import { trabajos } from '../content';
import Foto from './Foto.astro';
import BotonContacto from './BotonContacto.astro';
---

<section id="trabajos" class="seccion" aria-labelledby="trabajos-titulo">
  <div class="contenedor trabajos">
    <h2 id="trabajos-titulo" class="trabajos__titulo">{trabajos.titulo}</h2>
    <ul class="trabajos__grilla">
      {trabajos.casos.map((caso) => (
        <li class="caso">
          <Foto foto={caso.foto} proporcion="3 / 4" sizes="(min-width: 1024px) 25vw, 50vw" />
          <h3 class="caso__nombre">{caso.nombre}</h3>
          <p class="caso__contexto">{caso.contexto}</p>
        </li>
      ))}
    </ul>
    <BotonContacto origen="web-trabajos" variante="secundario" class="trabajos__cta" />
  </div>
</section>

<style>
  /* Mobile: título, grilla de 2 columnas y el botón al final, a lo ancho. */
  .trabajos {
    display: grid;
    gap: var(--space-6);
  }

  .trabajos__grilla {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-3);
  }

  .caso__nombre {
    margin-top: var(--space-3);
    font-size: var(--text-body);
  }

  .caso__contexto {
    margin-top: var(--space-1);
    color: var(--texto-suave);
    font-size: var(--text-small);
  }

  /* Desktop: el botón sube al lado del título. */
  @media (min-width: 768px) {
    .trabajos {
      grid-template-columns: 1fr auto;
      align-items: end;
      row-gap: var(--space-7);
    }

    .trabajos__grilla {
      grid-column: 1 / -1;
      grid-row: 2;
      gap: var(--space-7) var(--space-4);
    }

    .trabajos :global(.trabajos__cta) {
      grid-column: 2;
      grid-row: 1;
    }

    .caso__nombre {
      margin-top: var(--space-4);
      font-size: var(--text-h3);
    }
  }

  @media (min-width: 1024px) {
    .trabajos__grilla {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
