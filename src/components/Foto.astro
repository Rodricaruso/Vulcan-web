---
// Busca la foto en /imagenes por su nombre (sin extensión). Si está, la optimiza
// (WebP en varios tamaños); si no, muestra un placeholder con la proporción correcta.
import { Image } from 'astro:assets';
import type { Foto } from '../content';
import { buscarImagen } from '../lib/imagenes';

interface Props {
  foto: Foto;
  proporcion: string; // ej. '3 / 4'. Una sección puede cambiarla en mobile pisando aspect-ratio.
  carga?: 'eager' | 'lazy';
  prioridad?: boolean; // la foto principal de la página: el navegador la pide antes que el resto
  sizes?: string;
  class?: string;
}

const { foto, proporcion, carga = 'lazy', prioridad = false, sizes = '(min-width: 768px) 40vw, 100vw', class: clase } = Astro.props;

const imagen = buscarImagen(foto.archivo);
---

{imagen ? (
  <Image
    class:list={['foto', clase]}
    src={imagen}
    alt={foto.alt}
    widths={[480, 800, 1200]}
    sizes={sizes}
    format="webp"
    quality={80}
    loading={carga}
    fetchpriority={prioridad ? 'high' : undefined}
    style={`--proporcion: ${proporcion}`}
  />
) : (
  <div class:list={['foto foto--placeholder', clase]} style={`--proporcion: ${proporcion}`} role="img" aria-label={foto.alt}>
    <span>{foto.etiqueta}<br />imagenes/{foto.archivo}</span>
  </div>
)}

<style>
  .foto {
    width: 100%;
    aspect-ratio: var(--proporcion);
    object-fit: cover;
    border-radius: var(--radius);
  }

  .foto--placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background:
      linear-gradient(135deg, transparent 49.6%, var(--borde) 49.8%, var(--borde) 50.2%, transparent 50.4%),
      color-mix(in srgb, var(--texto) 6%, var(--fondo));
    border: 1px solid var(--borde);
    color: var(--texto-suave);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    text-align: center;
  }

  .foto--placeholder {
    container-type: inline-size;
  }

  .foto--placeholder span {
    background: var(--fondo);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    overflow-wrap: anywhere;
  }

  /* En recuadros muy chicos el rótulo no entra: se oculta (el alt sigue estando). */
  @container (max-width: 120px) {
    .foto--placeholder span {
      display: none;
    }
  }
</style>
