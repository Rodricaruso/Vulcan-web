---
import { cinta } from '../content';

// Cantidad par de copias: la pista se desplaza la mitad y empalma sin salto.
const copias = 4;
---

<section class="cinta" aria-label={cinta.frases.join('. ')} data-cinta>
  <div class="cinta__banda">
    <div class="cinta__pista">
      {Array.from({ length: copias }, (_, c) => (
        <div class="cinta__grupo" aria-hidden="true">
          {cinta.frases.map((frase) => (
            <>
              <span class="cinta__frase">{frase}</span>
              <svg class="cinta__gota" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                <path d="M12 2.5c-2.9 4.2-6.5 8.6-6.5 12.3a6.5 6.5 0 0 0 13 0c0-3.7-3.6-8.1-6.5-12.3Z" fill="currentColor" />
                <path d="M9.2 15.2a3 3 0 0 0 2.4 2.7" fill="none" stroke="var(--color-accent)" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </>
          ))}
        </div>
      ))}
    </div>
    <button class="cinta__pausa" type="button" aria-pressed="false" aria-label={cinta.pausar} data-pausar={cinta.pausar} data-reanudar={cinta.reanudar}>
      <svg class="icono-pausa" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2" /></svg>
      <svg class="icono-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
    </button>
  </div>
</section>

<style>
  /* overflow: clip evita que la inclinación genere scroll horizontal. */
  .cinta {
    overflow: clip;
    padding-block: var(--space-7);
  }

  .cinta__banda {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-accent);
    color: var(--color-bg);
    transform: rotate(-2deg);
    margin-inline: -5%;
    padding-block: var(--space-4);
  }

  .cinta__pista {
    display: flex;
    width: max-content;
    animation: desplazar 40s linear infinite;
  }

  .cinta[data-pausada] .cinta__pista,
  .cinta:hover .cinta__pista,
  .cinta:focus-within .cinta__pista {
    animation-play-state: paused;
  }

  .cinta__grupo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .cinta__frase {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1;
    white-space: nowrap;
    padding-inline: var(--space-6);
  }

  .cinta__gota {
    flex-shrink: 0;
  }

  .cinta__pausa {
    position: absolute;
    right: calc(5% + var(--gutter));
    display: grid;
    place-items: center;
    width: var(--tactil);
    height: var(--tactil);
    padding: 0;
    background: var(--color-bg);
    color: var(--color-text);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .cinta__pausa:focus-visible {
    outline-color: var(--color-bg);
  }

  .icono-play,
  .cinta[data-pausada] .icono-pausa {
    display: none;
  }

  .cinta[data-pausada] .icono-play {
    display: block;
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }

  /* Quieta y con cada frase una sola vez. */
  @media (prefers-reduced-motion: reduce) {
    .cinta__pista {
      animation: none;
      width: 100%;
      justify-content: center;
    }

    .cinta__grupo:not(:first-child),
    .cinta__pausa {
      display: none;
    }

    .cinta__grupo > :last-child {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cinta]').forEach((cinta) => {
    const boton = cinta.querySelector<HTMLButtonElement>('.cinta__pausa');
    boton?.addEventListener('click', () => {
      const pausada = cinta.toggleAttribute('data-pausada');
      boton.setAttribute('aria-pressed', String(pausada));
      boton.setAttribute('aria-label', (pausada ? boton.dataset.reanudar : boton.dataset.pausar) ?? '');
    });
  });
</script>
