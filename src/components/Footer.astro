---
import { menu, pie, sitio } from '../content';
import { enlaceWhatsApp } from '../lib/whatsapp';
import Logo from './Logo.astro';

const anio = new Date().getFullYear();
const enlaces = [...menu, pie.menuExtra];
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__fila">
      <div class="pie__marca">
        <Logo />
        <p class="pie__ciudad">{sitio.ciudad}</p>
      </div>

      <nav aria-label="Pie de página">
        <ul class="pie__menu">
          {enlaces.map((item) => <li><a href={item.href}>{item.texto}</a></li>)}
        </ul>
      </nav>

      <ul class="pie__redes">
        {sitio.instagram && (
          <li>
            <a href={sitio.instagram} target="_blank" rel="noopener" aria-label={`Instagram de ${sitio.nombre}`}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
            </a>
          </li>
        )}
        <li>
          <a href={enlaceWhatsApp('web-footer')} target="_blank" rel="noopener" aria-label={`WhatsApp de ${sitio.nombre}`} data-ref="web-footer">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M9 8.5c0 3.6 2.9 6.5 6.5 6.5l1-1.6-2-1-.9.9a4.5 4.5 0 0 1-2.4-2.4l.9-.9-1-2L9 8.5Z" fill="currentColor" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <p class="pie__legal">
      © {anio} {sitio.nombre} · <a href={pie.privacidad.href}>{pie.privacidad.texto}</a>
    </p>
  </div>
</footer>

<style>
  .pie {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8) var(--space-6);
  }

  .pie__fila {
    display: grid;
    gap: var(--space-6);
  }

  .pie__ciudad {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .pie__menu,
  .pie__redes {
    list-style: none;
    padding: 0;
  }

  .pie__menu {
    display: grid;
  }

  .pie__menu a,
  .pie__redes a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    color: var(--color-text);
    text-decoration: none;
  }

  .pie__menu a:hover,
  .pie__redes a:hover {
    color: var(--color-accent);
  }

  .pie__redes {
    display: flex;
    gap: var(--space-2);
  }

  .pie__redes a {
    justify-content: center;
    min-width: var(--tactil);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
  }

  .pie__legal {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    max-width: none;
  }

  .pie__legal a {
    color: inherit;
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
  }

  @media (min-width: 768px) {
    .pie__fila {
      grid-template-columns: 1fr auto auto;
      gap: var(--space-8);
      align-items: start;
    }

    .pie__menu {
      grid-template-columns: repeat(2, auto);
      column-gap: var(--space-6);
    }
  }
</style>
