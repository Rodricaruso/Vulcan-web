---
import { pasos, textosUI } from '../content';
import Foto from './Foto.astro';
import BotonContacto from './BotonContacto.astro';
---

<section id="proceso" class="seccion pasos" aria-label="Del boceto a la pieza, en tres pasos">
  <div class="contenedor pasos__lista">
    {pasos.map((paso, i) => (
      <article class:list={['paso', { 'paso--espejo': i % 2 === 1 }]} aria-labelledby={`paso-${i + 1}`}>
        <Foto foto={paso.foto} proporcion="5 / 6" class="paso__foto" />
        <div class="paso__texto">
          <p class="etiqueta-mono paso__numero">{textosUI.paso} {i + 1}</p>
          <h2 id={`paso-${i + 1}`}>{paso.titulo}</h2>
          <p>{paso.texto}</p>
          <ul class="lista">
            {paso.items.map((item) => <li>{item}</li>)}
          </ul>
          {paso.cta && <BotonContacto origen="web-pasos" class="paso__cta" />}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .pasos__lista {
    display: grid;
    gap: var(--space-8);
  }

  .paso {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .paso__texto {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .paso__numero {
    color: var(--color-accent);
  }

  .paso__texto :global(.paso__cta) {
    margin-top: var(--space-3);
  }

  @media (min-width: 768px) {
    .pasos__lista {
      gap: var(--space-9);
    }

    .paso {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-8);
    }

    .paso--espejo {
      grid-template-columns: 3fr 2fr;
    }

    .paso--espejo :global(.paso__foto) {
      order: 2;
    }
  }
</style>
