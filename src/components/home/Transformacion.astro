---
// Acto 1 (el pico): la pieza es una moneda que gira con el scroll. Cada media vuelta
// la da vuelta y del otro lado aparece el estado siguiente: boceto, modelo 3D, resina, metal.
// Alrededor, una inscripción lapidaria que rota; detrás, el numeral romano del estado.
// Cada cambio de estado se marca con un golpe (onda que sale de la moneda).
// El motor solo fija el escenario (data-sc-act="pin"); el giro es propio.
//
// Composición: grilla de tres columnas en escritorio (texto · moneda · estados), todo
// centrado en vertical. En celular: moneda, estados en fila, texto. La moneda se dimensiona
// por su celda (container query) y el canto vive DENTRO de su caja: nunca invade al vecino.
import { transformacion, acciones } from '../../content';
import Foto from '../Foto.astro';

const { etapas, inscripcion } = transformacion;
const numerales = ['I', 'II', 'III', 'IV'];
---

<section class="tf" data-sc-act="pin" data-sc-span="4.6" aria-labelledby="tf-titulo" data-tf>
  <div class="tf__escenario" data-sc-stage>
    <div class="contenedor tf__grilla">
      <div class="tf__texto">
        <h1 id="tf-titulo" class="tf__titulo">{transformacion.titulo}</h1>
        <p class="tf__bajada">{transformacion.bajada}</p>
        <div class="tf__acciones">
          <!-- La principal baja a la orden de trabajo (que arma el mensaje); la secundaria, a los casos. -->
          <a class="boton boton--principal" href="#contacto">{acciones.principal}</a>
          <a class="boton boton--secundario tf__secundario" href="#trabajos">{acciones.secundaria}</a>
        </div>
      </div>

      <div class="tf__celda">
        <div class="tf__moneda">
          <div class="tf__numerales" aria-hidden="true">
            {numerales.map((n, i) => <span class:list={['tf__numeral', { activo: i === 0 }]} data-tf-numeral>{n}</span>)}
          </div>

          <span class="tf__onda" aria-hidden="true" data-tf-onda></span>

          <!-- Canto de la moneda: estriado y la inscripción, que giran con el scroll. -->
          <svg class="tf__canto" viewBox="0 0 400 400" aria-hidden="true">
            <defs>
              <path id="tf-giro" d="M200 200 m-178 0 a178 178 0 1 1 356 0 a178 178 0 1 1 -356 0" />
            </defs>
            <circle class="tf__estrias" cx="200" cy="200" r="196" />
            <circle class="tf__filete" cx="200" cy="200" r="160" />
            <text class="tf__inscripcion"><textPath href="#tf-giro">{inscripcion}</textPath></text>
          </svg>

          <div class="tf__disco">
            <div class="tf__cara" data-tf-cara>
              {etapas.map((etapa, i) => (
                <div class="tf__capa" style={i === 0 ? '' : 'opacity: 0'} data-tf-capa>
                  <Foto foto={etapa.foto} proporcion="1 / 1" carga="eager" sizes="(min-width: 1024px) 34vw, 80vw" class="tf__foto" />
                </div>
              ))}
              <span class="tf__brillo" aria-hidden="true"></span>
            </div>
          </div>

          <!-- Diámetro: aparece mientras la pieza es modelo 3D. Rótulo, no medida inventada. -->
          <svg class="tf__cota" viewBox="0 0 400 400" aria-hidden="true">
            <path d="M88 318 H312 M88 308 V328 M312 308 V328" />
            <text x="200" y="304" text-anchor="middle">Ø a tu medida</text>
          </svg>
        </div>
      </div>

      <ol class="tf__estados" aria-label="Estados de la pieza">
        {etapas.map((etapa, i) => (
          <li class:list={['tf__estado', { activo: i === 0 }]} aria-current={i === 0 ? 'step' : undefined} data-tf-estado>
            <span class="tf__num">{numerales[i]}</span>
            <span class="tf__nombre">{etapa.nombre}</span>
            <span class="tf__detalle">{etapa.detalle}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .tf__escenario {
    background:
      radial-gradient(closest-side at 50% 38%, rgb(191 155 116 / 0.13), transparent 72%),
      var(--color-bg) url('/texturas/forja.webp') center top / 100% auto;
    overflow: clip;
  }

  /* ------------------------------------------------------------- grilla -- */
  .tf__grilla {
    height: 100%;
    display: grid;
    grid-template-areas:
      'moneda'
      'estados'
      'texto';
    grid-template-rows: auto auto auto;
    align-content: center;
    gap: var(--space-5);
    padding-top: 72px;
    padding-bottom: var(--space-5);
  }

  .tf__texto {
    grid-area: texto;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .tf__celda {
    grid-area: moneda;
    container-type: inline-size;
    display: grid;
    place-items: center;
    min-width: 0;
  }

  .tf__estados {
    grid-area: estados;
  }

  /* --------------------------------------------------------------- texto -- */
  .tf__titulo {
    font-size: clamp(2.1rem, 1.3rem + 3.4vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    max-width: 12ch;
  }

  .tf__bajada {
    color: var(--color-text-muted);
    max-width: 34ch;
  }

  .tf__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* -------------------------------------------------------------- moneda -- */
  /* La caja es el canto completo; el disco ocupa el 78 % del centro. */
  .tf__moneda {
    --caja: min(100cqi, 46svh);
    position: relative;
    width: var(--caja);
    aspect-ratio: 1;
  }

  .tf__numerales {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .tf__numeral {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Sin esto la caja se limita a la mitad derecha de la moneda y el centrado se corre. */
    width: max-content;
    white-space: nowrap;
    translate: -50% -52%;
    font-family: var(--font-display);
    font-size: calc(var(--caja) * 1.25);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(191 155 116 / 0.2);
    opacity: 0;
    transform: translateY(5%) scale(0.96);
    transition: opacity 600ms var(--sc-ease-out), transform 900ms var(--sc-ease-out);
  }

  .tf__numeral.activo {
    opacity: 1;
    transform: none;
  }

  .tf__canto,
  .tf__cota {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .tf__canto {
    transform: rotate(calc(var(--tf-p, 0) * -220deg));
  }

  .tf__estrias {
    fill: none;
    stroke: rgb(191 155 116 / 0.5);
    stroke-width: 6;
    stroke-dasharray: 1.2 4;
  }

  .tf__filete {
    fill: none;
    stroke: rgb(191 155 116 / 0.35);
    stroke-width: 1;
  }

  .tf__inscripcion {
    fill: var(--color-accent);
    font-family: var(--font-display);
    font-size: 17px;
    /* Espaciado calculado para que la inscripción dé la vuelta completa al canto. */
    letter-spacing: 0.49em;
  }

  .tf__disco {
    position: absolute;
    inset: 11%;
    perspective: 1400px;
  }

  .tf__cara {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-surface);
    transform: rotateY(calc(var(--tf-phi, 0) * 1deg)) scale(calc(1 - 0.08 * var(--tf-canto, 0)));
    box-shadow:
      0 0 0 1px rgb(211 180 143 / 0.55),
      0 0 0 6px rgb(29 6 5 / 0.9),
      0 0 0 7px rgb(191 155 116 / 0.35),
      0 40px 80px -30px rgb(0 0 0 / 0.8);
  }

  .tf__cara.golpe {
    animation: golpe 360ms cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .tf__capa {
    position: absolute;
    inset: 0;
  }

  .tf__capa :global(.tf__foto) {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* Reflejo de metal que barre la cara mientras gira. */
  .tf__brillo {
    position: absolute;
    inset: -20%;
    background: linear-gradient(105deg, transparent 35%, rgb(255 236 210 / 0.55) 50%, transparent 65%);
    transform: translateX(calc(var(--tf-phi, 0) * 0.9%));
    opacity: var(--tf-canto, 0);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .tf__onda {
    position: absolute;
    inset: 11%;
    border-radius: 50%;
    border: 1px solid var(--color-accent-hover);
    opacity: 0;
    pointer-events: none;
  }

  .tf__onda.golpe {
    animation: onda 900ms cubic-bezier(0.1, 0.7, 0.3, 1);
  }

  .tf__cota {
    opacity: var(--cotas, 0);
  }

  .tf__cota path {
    fill: none;
    stroke: var(--color-accent-on-light);
    stroke-width: 1.4;
  }

  .tf__cota text {
    fill: var(--color-accent-on-light);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* ------------------------------------------------------------- estados -- */
  .tf__estados {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .tf__estado {
    display: grid;
    gap: 2px;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    transition: color var(--dur-4) var(--ease-out), border-color var(--dur-4) var(--ease-out);
  }

  .tf__estado.activo {
    color: var(--color-text);
    border-top-color: var(--color-accent);
  }

  .tf__num {
    font-family: var(--font-display);
    font-size: var(--text-body);
    color: var(--color-accent);
  }

  .tf__nombre {
    font-family: var(--font-mono);
  }

  .tf__detalle {
    display: none;
  }

  /* --------------------------------------------------------------- celular -- */
  @media (max-width: 767px) {
    .tf__secundario,
    .tf__bajada {
      display: none;
    }

    .tf__moneda {
      --caja: min(100cqi, 44svh);
    }
  }

  @media (max-width: 767px) and (min-height: 760px) {
    .tf__bajada {
      display: block;
      font-size: var(--text-small);
    }
  }

  /* -------------------------------------------------------------- tablet -- */
  @media (min-width: 768px) and (max-width: 1023px) {
    .tf__grilla {
      grid-template-areas:
        'moneda moneda'
        'texto estados';
      grid-template-columns: 1fr 15rem;
      align-items: end;
    }

    .tf__moneda {
      --caja: min(100cqi, 50svh);
    }

    .tf__estados {
      grid-template-columns: none;
    }
  }

  /* ---------------------------------------------------------- escritorio -- */
  @media (min-width: 1024px) {
    .tf__grilla {
      grid-template-areas: 'texto moneda estados';
      grid-template-columns: minmax(0, 4.6fr) minmax(0, 5fr) minmax(11rem, 2fr);
      grid-template-rows: none;
      align-items: center;
      column-gap: clamp(2rem, 4vw, 4.5rem);
      padding-bottom: var(--space-6);
    }

    .tf__moneda {
      /* Alto disponible: pantalla menos barra y aire. */
      --caja: min(100cqi, calc(100svh - 72px - 7rem));
    }

    .tf__bajada {
      font-size: var(--text-lead);
    }

    .tf__estados {
      grid-template-columns: none;
      gap: var(--space-4);
    }

    .tf__estado {
      grid-template-columns: 2.25rem 1fr;
      font-size: var(--text-small);
    }

    .tf__num {
      grid-row: span 2;
    }

    .tf__detalle {
      display: block;
      font-size: var(--text-meta);
      color: var(--color-text-muted);
    }
  }

  @keyframes golpe {
    0% {
      scale: 0.965;
    }
    100% {
      scale: 1;
    }
  }

  @keyframes onda {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.55);
    }
  }
</style>

<script>
  // Tramos de giro (progreso del acto). Entre tramo y tramo, la moneda descansa en un estado.
  const GIROS: [number, number][] = [
    [0.1, 0.3],
    [0.38, 0.58],
    [0.66, 0.86],
  ];
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const suave = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  const seccion = document.querySelector<HTMLElement>('[data-tf]');
  if (seccion) {
    const cara = seccion.querySelector<HTMLElement>('[data-tf-cara]')!;
    const onda = seccion.querySelector<HTMLElement>('[data-tf-onda]')!;
    const capas = Array.from(seccion.querySelectorAll<HTMLElement>('[data-tf-capa]'));
    const estados = Array.from(seccion.querySelectorAll<HTMLElement>('[data-tf-estado]'));
    const numerales = Array.from(seccion.querySelectorAll<HTMLElement>('[data-tf-numeral]'));
    const reducido = matchMedia('(prefers-reduced-motion: reduce)');
    let actual = 0;
    let pendiente = false;

    const golpear = (el: HTMLElement) => {
      el.classList.remove('golpe');
      void el.offsetWidth;
      el.classList.add('golpe');
    };

    const pintar = () => {
      pendiente = false;
      const r = seccion.getBoundingClientRect();
      const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
      seccion.style.setProperty('--tf-p', p.toFixed(4));

      // Ángulo total: media vuelta por cada giro.
      const theta = GIROS.reduce((suma, [a, b]) => suma + 180 * suave(clamp((p - a) / (b - a))), 0);
      const indice = Math.min(capas.length - 1, Math.round(theta / 180));
      // La cara siempre se ve de frente o de canto: entre -90 y 90 grados.
      const phi = theta - 180 * Math.round(theta / 180);

      if (reducido.matches) {
        cara.style.setProperty('--tf-phi', '0');
        cara.style.setProperty('--tf-canto', '0');
      } else {
        cara.style.setProperty('--tf-phi', phi.toFixed(2));
        cara.style.setProperty('--tf-canto', Math.sin((Math.abs(phi) * Math.PI) / 180).toFixed(3));
      }

      // El diámetro vive mientras la pieza es modelo 3D y la moneda está quieta.
      const cotas = clamp((p - 0.3) / 0.04) * (1 - clamp((p - 0.38) / 0.03));
      seccion.style.setProperty('--cotas', cotas.toFixed(3));

      if (indice !== actual) {
        capas.forEach((c, i) => (c.style.opacity = i === indice ? '' : '0'));
        estados.forEach((li, i) => {
          li.classList.toggle('activo', i === indice);
          if (i === indice) li.setAttribute('aria-current', 'step');
          else li.removeAttribute('aria-current');
        });
        numerales.forEach((n, i) => n.classList.toggle('activo', i === indice));
        if (indice > actual && !reducido.matches) {
          golpear(onda);
          golpear(cara);
        }
        actual = indice;
      }
    };

    const pedir = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    reducido.addEventListener('change', pedir);
    pintar();
  }
</script>
