---
// Acto 6 (cierre y firma de la web): la orden de trabajo.
// El visitante elige pieza, metal, terminación y piedra; cuando decidió las cuatro, el sello
// de Vulcan se estampa sobre la orden (el anillo sello es la pieza que abre la página).
// El botón es un enlace real a WhatsApp que se reescribe con cada elección.
import { orden, sitio, mensajes } from '../../content';
import { enlaceWhatsApp } from '../../lib/whatsapp';
import Sello from '../Sello.astro';
import Lamina from './Lamina.astro';

const ref = 'web-orden';
const saludo = mensajes.cliente.replace('{ref}', ref);
---

<section id="contacto" class="orden" data-sc-act="flow" aria-labelledby="orden-titulo">
  <div class="contenedor orden__grilla">
    <!-- Columna izquierda: el título y la lámina, que dibuja la pieza que se va pidiendo. -->
    <div class="orden__lateral">
      <header class="orden__cabecera" data-sc-in>
        <h2 id="orden-titulo">{orden.titulo}</h2>
        <p class="bajada">{orden.bajada}</p>
      </header>
      <div class="orden__lamina">
        <Lamina />
      </div>
    </div>

    <div class="orden__papel" data-sc-reveal="up" data-sc-reveal-at="0.12 0.42">
      <form class="ficha" data-orden data-telefono={sitio.whatsapp} data-saludo={saludo}>
        <div class="ficha__encabezado">
          <p class="ficha__titulo">{orden.ficha}</p>
          <p class="ficha__meta"><span>{sitio.nombre} · CABA · </span><time data-orden-fecha></time></p>
        </div>

        <!-- Solo en celular: el avance de la orden, un punto por paso. Se puede volver tocándolos. -->
        <div class="ficha__avance" data-avance hidden>
          <span class="ficha__contador" aria-hidden="true" data-contador></span>
          <div class="ficha__puntos">
            {[...orden.campos.map((c) => c.etiqueta), orden.idea.etiqueta].map((etiqueta, i) => (
              <button type="button" class="ficha__punto" aria-label={`Paso ${i + 1}: ${etiqueta}`} data-punto={i}></button>
            ))}
          </div>
        </div>

        {orden.campos.map((campo) => (
          <fieldset class="ficha__campo" data-paso>
            <legend><span class="ficha__etiqueta">{campo.etiqueta}</span><span class="ficha__pregunta">{campo.pregunta}</span></legend>
            <div class="ficha__opciones">
              {campo.opciones.map((opcion) => (
                <label class="ficha__opcion">
                  <input type="radio" name={campo.id} value={opcion} data-etiqueta={campo.etiqueta} />
                  <span>{opcion}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}

        <div class="ficha__final" data-paso>
          <div class="ficha__campo">
            <label class="ficha__leyenda" for="orden-idea"><span class="ficha__etiqueta">{orden.idea.etiqueta}</span><span class="ficha__pregunta">{orden.idea.pregunta}</span></label>
            <textarea id="orden-idea" name="idea" rows="2" maxlength="280" aria-describedby="orden-idea-ayuda"></textarea>
            <p id="orden-idea-ayuda" class="ficha__ayuda">{orden.idea.ayuda}</p>
          </div>

          <div class="ficha__pie">
            <a class="boton boton--principal ficha__enviar" href={enlaceWhatsApp(ref)} target="_blank" rel="noopener" data-ref={ref} data-orden-enviar>
              {orden.enviar}
            </a>
            <p class="ficha__aviso">{orden.pie}</p>
          </div>
        </div>

        <div class="ficha__sello" data-orden-sello>
          <Sello id="sello-orden" estado="relieve" texto={`VULCAN · TALLER · CABA · ${orden.sellado.toUpperCase()} ·`} />
        </div>
        <p class="sr-only" aria-live="polite" data-orden-estado></p>
      </form>
    </div>
  </div>
</section>

<style>
  .orden {
    padding-block: calc(var(--seccion) * 1.6) calc(var(--seccion) * 1.4);
  }

  .orden__grilla {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .orden__lateral {
    display: grid;
    gap: var(--space-6);
  }

  .orden__lamina {
    width: min(100%, 24rem);
    justify-self: center;
  }

  .orden__cabecera {
    display: grid;
    gap: var(--space-4);
  }

  .orden__cabecera h2 {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem);
    line-height: 1.04;
  }

  /* La orden es papel: cera sobre la forja, como una ficha de taller. */
  .ficha {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.3), 0 24px 60px -20px rgb(0 0 0 / 0.7);
    --texto-suave: #5e4a3f;
    --foco: var(--color-accent-on-light);
  }

  .ficha__encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgb(29 6 5 / 0.3);
  }

  .ficha__titulo {
    font-family: var(--font-display);
    font-size: 1.75rem;
  }

  .ficha__meta {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--texto-suave);
  }

  .ficha__campo {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .ficha__campo legend,
  .ficha__leyenda {
    padding: 0;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--texto-suave);
  }

  .ficha__opciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ficha__opcion {
    position: relative;
  }

  .ficha__opcion input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .ficha__opcion span {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    padding-inline: var(--space-4);
    border: 1px solid rgb(29 6 5 / 0.24);
    border-radius: var(--radius);
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }

  .ficha__opcion:hover span {
    border-color: var(--color-bg);
  }

  .ficha__opcion input:checked + span {
    background: var(--color-bg);
    border-color: var(--color-bg);
    color: var(--color-text);
  }

  .ficha__opcion input:focus-visible + span {
    outline: 2px solid var(--color-accent-on-light);
    outline-offset: 2px;
  }

  .ficha textarea {
    width: 100%;
    min-height: 4.5rem;
    padding: var(--space-3);
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgb(29 6 5 / 0.4);
    border-radius: 0;
    font: inherit;
    color: inherit;
    resize: vertical;
  }

  .ficha textarea:focus-visible {
    outline: 2px solid var(--color-accent-on-light);
    border-radius: var(--radius);
  }

  .ficha__ayuda,
  .ficha__aviso {
    font-size: var(--text-small);
    color: var(--texto-suave);
  }

  .ficha__pie {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-top: var(--space-2);
    max-width: calc(100% - 7rem);
  }

  .ficha__enviar {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .ficha__enviar:hover {
    background: var(--color-surface-2);
  }

  /* El sello: en relieve seco mientras la orden está abierta; se entinta cuando está decidida. */
  .ficha__sello {
    position: absolute;
    right: clamp(0.75rem, 2.5vw, 2rem);
    bottom: clamp(0.75rem, 2.5vw, 2rem);
    width: clamp(6.5rem, 12vw, 9rem);
    pointer-events: none;
    transform: rotate(-9deg);
    --sello-papel: var(--color-text);
  }

  .ficha__sello.sellado {
    animation: estampar-orden 460ms cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }

  @keyframes estampar-orden {
    0% {
      transform: rotate(-18deg) scale(1.7);
      opacity: 0;
    }
    60% {
      transform: rotate(-9deg) scale(0.94);
      opacity: 1;
    }
    100% {
      transform: rotate(-9deg) scale(1);
    }
  }

  .ficha__final {
    display: grid;
    gap: var(--space-5);
  }

  /* La pregunta y el avance son del modo por pasos (celular); en el resto se lee la etiqueta. */
  .ficha__pregunta {
    display: none;
  }

  /* ---------------------------------------------- celular: la escena -- */
  /* La lámina ocupa la pantalla (~70 %) y la orden queda abajo como un panel chico que se
     completa de a un paso. Lámina y panel quedan fijos un tramo de scroll. Solo con JS
     (clase .escena): sin JS, todo se apila y la orden se ve entera. */
  @media (max-width: 1023px) {
    .orden.escena {
      --panel: 15rem;
      --alto: calc(100svh - 72px);
    }

    /* El lateral se disuelve: título, lámina y panel quedan hermanos en la grilla,
       así lámina y panel pueden quedar fijos juntos. */
    .escena .orden__lateral {
      display: contents;
    }

    .escena .orden__grilla {
      gap: 0;
    }

    .escena .orden__cabecera {
      margin-bottom: var(--space-6);
    }

    /* Un tramo extra para que la escena quede quieta un rato antes de seguir. */
    .escena .orden__grilla::after {
      content: '';
      height: 40svh;
    }

    .escena .orden__lamina {
      position: sticky;
      top: 72px;
      z-index: 2;
      width: auto;
      justify-self: stretch;
      height: calc(var(--alto) - var(--panel));
      padding-block: var(--space-3);
      display: grid;
      place-items: center;
    }

    .escena .orden__lamina :global(.lamina) {
      height: 100%;
    }

    .escena .orden__lamina :global(.lamina svg) {
      height: 100%;
      width: auto;
      max-width: 100%;
      margin-inline: auto;
    }

    .escena .orden__papel {
      position: sticky;
      top: calc(100svh - var(--panel));
      z-index: 3;
      height: var(--panel);
      /* Sin el barrido de entrada: su recorte escondería el sello, que cae fuera del panel. */
      clip-path: none !important;
    }

    .escena .ficha {
      height: 100%;
      align-content: start;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4) var(--space-4);
      border-radius: var(--radius) var(--radius) 0 0;
    }

    .escena .ficha__encabezado {
      display: none;
    }

    /* Avance: "2 / 5" y un punto por paso (lleno = respondido, con anillo = el actual). */
    .escena .ficha__avance {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .ficha__contador {
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      color: var(--texto-suave);
    }

    .ficha__puntos {
      display: flex;
    }

    /* El área táctil es de 44 px; el punto visible, chico. */
    .ficha__punto {
      display: grid;
      place-items: center;
      width: 36px;
      height: 44px;
      margin-block: -12px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    .ficha__punto::before {
      content: '';
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: 1px solid rgb(29 6 5 / 0.45);
      transition: background-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
    }

    .ficha__punto.hecho::before {
      background: var(--color-bg);
      border-color: var(--color-bg);
    }

    .ficha__punto[aria-current='step']::before {
      transform: scale(1.35);
      box-shadow: 0 0 0 3px var(--color-text), 0 0 0 4px var(--color-bg);
    }

    .ficha__punto:focus-visible {
      outline: 2px solid var(--color-accent-on-light);
      outline-offset: -4px;
      border-radius: var(--radius);
    }

    /* Un paso por vez. */
    .escena [data-paso]:not(.activo) {
      display: none;
    }

    .escena [data-paso].activo {
      animation: paso-entra var(--dur-3, 260ms) var(--ease-out) both;
    }

    .escena .ficha__etiqueta {
      display: none;
    }

    .escena .ficha__pregunta {
      display: block;
      font-family: var(--font-display);
      font-size: 1.375rem;
      line-height: 1.15;
      color: var(--color-bg);
    }

    .escena .ficha__campo legend,
    .escena .ficha__leyenda {
      margin-bottom: var(--space-1);
    }

    .escena .ficha__opcion span {
      padding-inline: var(--space-3);
      font-size: 0.9375rem;
    }

    /* Último paso: idea y botón compactos. */
    .escena .ficha__final {
      gap: var(--space-3);
    }

    .escena .ficha textarea {
      height: var(--tactil);
      min-height: 0;
      padding-block: var(--space-2);
      resize: none;
    }

    .escena .ficha__ayuda {
      display: none;
    }

    .escena .ficha__pie {
      gap: var(--space-2);
      padding-top: 0;
      max-width: none;
    }

    .escena .ficha__aviso {
      font-size: var(--text-meta);
    }

    /* El sello cae sobre la esquina de la lámina, justo arriba del panel. */
    .escena .ficha__sello {
      top: auto;
      bottom: calc(100% + var(--space-2));
      right: var(--space-3);
      width: 5.5rem;
    }

    @keyframes paso-entra {
      from {
        opacity: 0;
        transform: translateX(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (max-width: 1023px) and (prefers-reduced-motion: reduce) {
    .escena [data-paso].activo {
      animation: none;
    }
  }

  @media (min-width: 1024px) {
    .orden__grilla {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-9);
    }

    .orden__lateral {
      position: sticky;
      top: calc(72px + var(--space-6));
    }

    /* La lámina entra entera en pantalla junto al título. */
    .orden__lamina {
      width: min(100%, calc((100svh - 72px - 15rem) * 0.8));
    }
  }
</style>

<script>
  const ficha = document.querySelector<HTMLFormElement>('[data-orden]');
  if (ficha) {
    const enviar = ficha.querySelector<HTMLAnchorElement>('[data-orden-enviar]')!;
    const sello = ficha.querySelector<HTMLElement>('[data-orden-sello]')!;
    const marca = sello.querySelector<SVGElement>('[data-sello]')!;
    const trazo = sello.querySelector<SVGGElement>('[data-sello-marca]')!;
    const estado = ficha.querySelector<HTMLElement>('[data-orden-estado]')!;
    const fecha = ficha.querySelector<HTMLTimeElement>('[data-orden-fecha]');
    const campos = Array.from(new Set(Array.from(ficha.querySelectorAll<HTMLInputElement>('input[type=radio]')).map((r) => r.name)));
    const { telefono = '', saludo = '' } = ficha.dataset;

    if (fecha) {
      const hoy = new Date();
      fecha.dateTime = hoy.toISOString().slice(0, 10);
      fecha.textContent = hoy.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    const actualizar = () => {
      const datos = new FormData(ficha);
      const lineas: string[] = [];
      for (const nombre of campos) {
        const valor = datos.get(nombre);
        if (!valor) continue;
        const etiqueta = ficha.querySelector<HTMLInputElement>(`input[name="${nombre}"]`)?.dataset.etiqueta ?? nombre;
        lineas.push(`${etiqueta}: ${valor}`);
      }
      const idea = String(datos.get('idea') ?? '').trim();
      if (idea) lineas.push(`Idea: ${idea}`);
      const texto = lineas.length ? `${saludo}\n${lineas.join('\n')}` : saludo;
      enviar.href = `https://wa.me/${telefono}?text=${encodeURIComponent(texto)}`;

      const decidida = campos.every((nombre) => datos.get(nombre));
      if (decidida !== sello.classList.contains('sellado')) {
        sello.classList.toggle('sellado', decidida);
        // Relieve seco a tinta: cambia el estado del sello y le pone la textura de tinta.
        marca.classList.toggle('sello--tinta', decidida);
        marca.classList.toggle('sello--relieve', !decidida);
        if (decidida) trazo.setAttribute('filter', trazo.dataset.filtro ?? '');
        else trazo.removeAttribute('filter');
        estado.textContent = decidida ? 'Orden sellada. Ya la podés mandar por WhatsApp.' : '';
      }
    };

    ficha.addEventListener('change', actualizar);
    ficha.addEventListener('input', actualizar);
    ficha.addEventListener('submit', (e) => e.preventDefault());
    actualizar();

    // Celular: la escena. La orden se completa de a un paso; al elegir una opción pasa sola
    // al siguiente, con una pausa para ver reaccionar la lámina.
    const seccion = ficha.closest<HTMLElement>('.orden')!;
    const avance = ficha.querySelector<HTMLElement>('[data-avance]')!;
    const contador = ficha.querySelector<HTMLElement>('[data-contador]')!;
    const pasos = Array.from(ficha.querySelectorAll<HTMLElement>('[data-paso]'));
    const puntos = Array.from(ficha.querySelectorAll<HTMLButtonElement>('[data-punto]'));
    const celular = matchMedia('(max-width: 1023px)');
    let actual = 0;
    let espera = 0;

    const irA = (i: number) => {
      clearTimeout(espera);
      actual = i;
      pasos.forEach((p, k) => p.classList.toggle('activo', k === i));
      puntos.forEach((b, k) => {
        if (k === i) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
        const radio = pasos[k].querySelector('input[type=radio]');
        b.classList.toggle('hecho', radio ? !!pasos[k].querySelector('input:checked') : false);
      });
      contador.textContent = `${i + 1} / ${pasos.length}`;
    };

    const modo = () => {
      seccion.classList.toggle('escena', celular.matches);
      avance.hidden = !celular.matches;
      if (celular.matches) irA(actual);
    };

    puntos.forEach((b, k) => b.addEventListener('click', () => irA(k)));
    ficha.addEventListener('change', (e) => {
      if (!celular.matches || !(e.target instanceof HTMLInputElement) || e.target.type !== 'radio') return;
      irA(actual);
      if (actual < pasos.length - 1) espera = window.setTimeout(() => irA(actual + 1), 650);
    });
    celular.addEventListener('change', modo);
    modo();
  }
</script>
