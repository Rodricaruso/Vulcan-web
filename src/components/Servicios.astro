---
// Cada tarjeta lleva la foto de su página de servicio y entera es un enlace a esa página.
// El botón de WhatsApp queda por encima del enlace y sigue abriendo el chat.
import { servicios, paginasServicio } from '../content';
import BotonContacto from './BotonContacto.astro';
import Foto from './Foto.astro';

const fotoDe = (pagina: string) => paginasServicio.find((s) => pagina.endsWith(`/${s.slug}`))?.foto;
---

<section id="servicios" class="seccion" aria-labelledby="servicios-titulo">
  <div class="contenedor">
    <div class="servicios__cabecera">
      <h2 id="servicios-titulo">{servicios.titulo}</h2>
      <p class="bajada">{servicios.bajada}</p>
    </div>
    <ul class="servicios__grilla">
      {servicios.tarjetas.map((tarjeta) => (
        <li class="tarjeta">
          {fotoDe(tarjeta.pagina) && (
            <div class="tarjeta__foto">
              <Foto foto={fotoDe(tarjeta.pagina)!} proporcion="4 / 3" sizes="(min-width: 1024px) 30vw, 100vw" />
            </div>
          )}
          <div class="tarjeta__cuerpo">
            <h3><a class="tarjeta__enlace" href={tarjeta.pagina}>{tarjeta.titulo}</a></h3>
            <p>{tarjeta.texto}</p>
            <ul class="lista tarjeta__items">
              {tarjeta.items.map((item) => <li>{item}</li>)}
            </ul>
            <BotonContacto origen={tarjeta.ref} tipo={tarjeta.tipo} variante="secundario" class="tarjeta__cta" />
          </div>
        </li>
      ))}
    </ul>
    <p class="servicios__pie">{servicios.pie}</p>
  </div>
</section>

<style>
  .servicios__cabecera {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .servicios__grilla {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease;
  }

  .tarjeta:hover {
    border-color: var(--color-accent);
  }

  .tarjeta__foto {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .tarjeta__foto :global(.foto) {
    border-radius: 0;
    transition: transform 0.4s ease;
  }

  .tarjeta:hover .tarjeta__foto :global(.foto) {
    transform: scale(1.03);
  }

  .tarjeta__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
  }

  .tarjeta__items {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .tarjeta :global(.tarjeta__cta) {
    margin-top: auto;
    align-self: flex-start;
  }

  .tarjeta__items {
    margin-bottom: var(--space-3);
  }

  .tarjeta__enlace {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .tarjeta:hover .tarjeta__enlace {
    color: var(--color-accent);
  }

  /* El enlace del título cubre la tarjeta entera, foto incluida. */
  .tarjeta__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tarjeta :global(.tarjeta__cta) {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta__foto :global(.foto) {
      transition: none;
    }
  }

  .servicios__pie {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  /* Mobile: tarjetas más compactas y botón a lo ancho. */
  @media (max-width: 767px) {
    .servicios__cabecera {
      margin-bottom: var(--space-6);
    }

    .tarjeta__cuerpo {
      gap: var(--space-3);
      padding: var(--space-5) var(--space-4);
    }

    .tarjeta :global(.tarjeta__cta) {
      align-self: stretch;
    }
  }

  @media (min-width: 1024px) {
    .servicios__grilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
